# Orto credentials for the CLI. Copy to .env so agents can run commands without flags.
# The encryption key is derived from these (PBKDF2); the server never sees the password.
ORTO_USER=
ORTO_PASS=

# (the old ZENOS_USER / ZENOS_PASS / ZENOS_SERVER names still work)
# Server side: ORTO_DEMO=1 turns on the public demo account (demo / demo), reset every ORTO_DEMO_HOURS hours (default 3).

# Server to talk to (default https://orto.scobrudot.dev)
# ORTO_SERVER=http://127.0.0.1:8787   # e.g. a local server

# Optional: Freenet P2P & TUI defaults (leave keys empty or pass via CLI)
# ORTO_MODE=freenet
# ORTO_FREENET_NODE=ws://127.0.0.1:7509/v1/contract/command
# ORTO_FREENET_KEY=
# ORTO_VISO_SEED=
# ORTO_VISO_INDEX=0
# ORTO_LOCK_MIN=0
