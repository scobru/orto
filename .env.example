# ZenOS Sovereign Credentials
# Copy this file to .env inside this directory to allow agents to interact without flags.
# Master keypairs (secp256k1) and AES-GCM encryption keys are derived deterministically.

ZENOS_USER=
ZENOS_PASS=

# Optional: Custom relays (comma-separated WebSocket URLs)
# ZENOS_RELAYS=wss://delay.scobrudot.dev/zen,wss://zen.akao.io:8420/zen
# ZENOS_ONLY_CUSTOM_RELAYS=false
