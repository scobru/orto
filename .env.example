# Orto credentials for the CLI. Copy to .env so agents can run commands without flags.
# The encryption key is derived from these (PBKDF2); the server never sees the password.
ORTO_USER=
ORTO_PASS=

# (the old ZENOS_USER / ZENOS_PASS / ZENOS_SERVER names still work)
# Server to talk to (default https://zenos.scobrudot.dev)
# ORTO_SERVER=http://127.0.0.1:8787   # e.g. a local server
