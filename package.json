{
  "name": "orto",
  "version": "0.3.0",
  "description": "Self-hosted Orto: encrypted notes, calendar, tasks, bookmarks, contacts, secrets, files and blog on a single SQLite file",
  "type": "module",
  "main": "orto.js",
  "bin": {
    "orto": "cli.js",
    "orto-server": "server.js",
    "orto-mcp": "mcp.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "desktop": "node --no-warnings desktop.js",
    "freenet:build": "node -e \"import('node:fs').then(fs => fs.writeFileSync('web/orto_vault.wasm', fs.readFileSync('contracts/orto_vault.wasm').subarray(40)))\" && npx esbuild src-freenet/vault.ts --bundle --minify --outfile=web/freenet-chunks.js --format=iife --global-name=FreenetChunksLib",
    "freenet:publish": "npm run freenet:build && node -e \"import('node:fs').then(fs => fs.copyFileSync('orto.js', 'web/orto.js'))\" && fdev website update web --key orto",
    "test": "node --no-warnings test.js && node --no-warnings test-freenet.js"
  },
  "keywords": [
    "self-hosted",
    "sqlite",
    "e2ee",
    "orto",
    "agentic",
    "autonomous-agents"
  ],
  "author": "scobru",
  "license": "MIT",
  "devDependencies": {
    "@freenetorg/freenet-stdlib": "^0.4.0",
    "@noble/hashes": "^2.4.0"
  }
}
